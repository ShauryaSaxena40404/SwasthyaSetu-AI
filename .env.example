# SwasthyaSetu AI — Environment Configuration

# --- Frontend Client Configuration ---
# REST API Base URL (leave /api for local dev proxy to port 5000)
VITE_API_BASE_URL=/api

# Optional: Set to 'true' to force client-side mock/demo store without network calls
VITE_USE_MOCK_API=false

# Supabase Public Configuration (Safe for frontend bundle with Row Level Security)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your_supabase_anon_publishable_key

# --- Backend Express Server Configuration ---
PORT=5000

# Backend Supabase Configuration (Optional: Backend can also use VITE_SUPABASE_URL if SUPABASE_URL not defined)
# SUPABASE_URL=https://your-project.supabase.co

# Backend Supabase Service-Role / Secret Key (OPTIONAL FOR ADMIN TASKS)
# WARNING: NEVER PREFIX THIS WITH VITE_ AND NEVER EXPOSE IT TO THE BROWSER
# SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# AI Provider Backend Secret (STORED STRICTLY ON BACKEND SERVER)
# AI_PROVIDER_API_KEY=your_gemini_or_openai_key_here
